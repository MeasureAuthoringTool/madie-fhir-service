<?xml version="1.0" encoding="UTF-8"?>

<ValueSet xmlns="http://hl7.org/fhir">
  <id value="qicore-non-negative-medication-admin-status"/>
  <text>
    <status value="extensions"/>
    <div xmlns="http://www.w3.org/1999/xhtml">
      <ul>
        <li>Include these codes as defined in 
          <a href="http://hl7.org/fhir/R4/codesystem-medication-admin-status.html">
            <code>http://terminology.hl7.org/CodeSystem/medication-admin-status</code>
          </a>
          <table class="none">
            <tr>
              <td style="white-space:nowrap">
                <b>Code</b>
              </td>
              <td>
                <b>Display</b>
              </td>
              <td>
                <b>Definition</b>
              </td>
            </tr>
            <tr>
              <td>
                <a href="http://hl7.org/fhir/R4/codesystem-medication-admin-status.html#medication-admin-status-in-progress">in-progress</a>
              </td>
              <td>In Progress</td>
              <td>The administration has started but has not yet completed.</td>
            </tr>
            <tr>
              <td>
                <a href="http://hl7.org/fhir/R4/codesystem-medication-admin-status.html#medication-admin-status-on-hold">on-hold</a>
              </td>
              <td>On Hold</td>
              <td>Actions implied by the administration have been temporarily halted, but are expected to continue later. May also be called 'suspended'.</td>
            </tr>
            <tr>
              <td>
                <a href="http://hl7.org/fhir/R4/codesystem-medication-admin-status.html#medication-admin-status-completed">completed</a>
              </td>
              <td>Completed</td>
              <td>All actions that are implied by the administration have occurred.</td>
            </tr>
            <tr>
              <td>
                <a href="http://hl7.org/fhir/R4/codesystem-medication-admin-status.html#medication-admin-status-entered-in-error">entered-in-error</a>
              </td>
              <td>Entered in Error</td>
              <td>The administration was entered in error and therefore nullified.</td>
            </tr>
            <tr>
              <td>
                <a href="http://hl7.org/fhir/R4/codesystem-medication-admin-status.html#medication-admin-status-stopped">stopped</a>
              </td>
              <td>Stopped</td>
              <td>Actions implied by the administration have been permanently halted, before all of them occurred.</td>
            </tr>
            <tr>
              <td>
                <a href="http://hl7.org/fhir/R4/codesystem-medication-admin-status.html#medication-admin-status-unknown">unknown</a>
              </td>
              <td>Unknown</td>
              <td>The authoring system does not know which of the status values currently applies for this request. Note: This concept is not to be used for 'other' - one of the listed statuses is presumed to apply, it's just not known which one.</td>
            </tr>
          </table>
        </li>
      </ul>
    </div>
  </text>
